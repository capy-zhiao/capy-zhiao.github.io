{%- comment -%}
  Expertise cards: icon and title, a one-line summary, then skill tags.
  Usage: {% include expertise.liquid entries=site.data.expertise %}
{%- endcomment -%}
<style>
  .expertise {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .expertise-card {
    padding: 1.25rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    background: var(--global-card-bg-color);
  }
  .expertise-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .expertise-icon {
    flex: 0 0 auto;
    font-size: 1.6rem;
    color: var(--global-theme-color);
  }
  .expertise-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .expertise-summary {
    margin-bottom: 0.9rem;
    color: var(--global-text-color-light);
  }
  .expertise-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .expertise-tag {
    padding: 0.1rem 0.55rem;
    border: 1.5px solid var(--global-theme-color);
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  /* Tablets: two cards per row. Phones: one. */
  @media (max-width: 767.98px) {
    .expertise {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 575.98px) {
    .expertise {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
<div class="expertise">
  {% for card in include.entries %}
    <div class="expertise-card">
      <div class="expertise-head">
        {% if card.icon %}
          <i class="expertise-icon {{ card.icon }}" aria-hidden="true"></i>
        {% endif %}
        <h3 class="expertise-title">{{ card.title }}</h3>
      </div>
      {% if card.summary %}
        <p class="expertise-summary">{{ card.summary }}</p>
      {% endif %}
      {% if card.tags and card.tags.size > 0 %}
        <div class="expertise-tags">
          {% for tag in card.tags %}
            <span class="expertise-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>
