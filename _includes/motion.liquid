{%- comment -%}
  Light motion for the homepage: a gradient line draws in under the name, a soft
  glow drifts behind the header, and sections rise into place as they scroll into
  view (cards and list entries one after another; skill rows only fade).

  Included at the top of the page, so `m-js` is on <html> before the content is
  painted: the hidden starting state never flashes. Without JavaScript, with reduced
  motion, or if the script fails, `m-js` is absent and everything is simply there.
{%- endcomment -%}
<script>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("m-js");
  })();
</script>
<style>
  :root {
    --m-g1: var(--global-theme-color);
    --m-g2: #8250df;
    --m-g3: #0aa5c0;
  }
  html[data-theme="dark"] {
    --m-g2: #b392f0;
    --m-g3: #56d4dd;
  }

  /* The name, with a gradient line that draws in and then slowly shifts colour */
  .post-header { position: relative; isolation: isolate; }
  .post-header .post-title { position: relative; display: inline-block; }
  .post-header .post-title::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--m-g1), var(--m-g2), var(--m-g3), var(--m-g1));
    background-size: 300% 100%;
    transform-origin: left;
    animation: m-draw 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both, m-pan 9s linear 1.1s infinite;
  }
  /* A soft glow drifting behind the header */
  .post-header::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -12%;
    top: -70%;
    width: 70%;
    height: 240%;
    pointer-events: none;
    background:
      radial-gradient(closest-side, color-mix(in srgb, var(--m-g1) 16%, transparent), transparent),
      radial-gradient(closest-side at 70% 60%, color-mix(in srgb, var(--m-g2) 12%, transparent), transparent);
    animation: m-drift 16s ease-in-out infinite alternate;
  }

  /* Section headings get a short gradient bar that grows in with them */
  article > h2 { position: relative; }
  article > h2::after {
    content: "";
    display: block;
    width: 2.25rem;
    height: 3px;
    margin-top: 0.3rem;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--m-g1), var(--m-g2));
    transform-origin: left;
  }
  .m-js article > h2::after { transform: scaleX(0); transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s; }
  .m-js article > h2.m-in::after { transform: scaleX(1); }

  /* Scroll reveal: these start hidden and rise in when they enter the viewport */
  .m-js :is(article > h2, .timeline-entry, .bibliography > li, .projects .col, .social, .personal-note) {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: var(--m-delay, 0ms);
  }
  /* Skill rows only fade in */
  .m-js .skills-row {
    opacity: 0;
    transition: opacity 0.6s ease;
    transition-delay: var(--m-delay, 0ms);
  }
  .m-js :is(article > h2, .timeline-entry, .bibliography > li, .projects .col, .skills-row, .social, .personal-note).m-in {
    opacity: 1;
    transform: none;
  }

  @keyframes m-draw { from { transform: scaleX(0); } }
  @keyframes m-pan { to { background-position: 300% 0; } }
  @keyframes m-drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(8%, 6%, 0) scale(1.12); }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-header .post-title::after, .post-header::before { animation: none; }
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var root = document.documentElement;
    if (!root.classList.contains("m-js")) return;
    try {
      /* What rises in. Entries that share a parent cascade, three at a time like the cards. */
      var groups = [
        "article > h2",
        ".timeline-entry",
        ".bibliography > li",
        ".projects .col",
        ".skills-row",
        ".social, .personal-note",
      ];
      var targets = [];
      groups.forEach(function (sel) {
        var lastParent = null;
        var i = 0;
        document.querySelectorAll(sel).forEach(function (el) {
          i = el.parentElement === lastParent ? i + 1 : 0;
          lastParent = el.parentElement;
          el.style.setProperty("--m-delay", (i % 3) * 90 + "ms");
          targets.push(el);
        });
      });

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add("m-in");
          io.unobserve(e.target);
        });
      }, { rootMargin: "0px 0px -8% 0px", threshold: 0.12 });
      targets.forEach(function (el) { io.observe(el); });
    } catch (err) {
      root.classList.remove("m-js"); /* never leave the page hidden */
    }
  });
</script>
