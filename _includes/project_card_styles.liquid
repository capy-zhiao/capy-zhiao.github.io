{%- comment -%}
  Makes the whole project card clickable through the title link (see
  projects.liquid). The theme's Bootstrap compatibility layer has no
  .stretched-link, so the rule lives here. The GitHub link sits above the
  stretched area, with any extra card links (live demo, paper), so they stay
  separately clickable.
{%- endcomment -%}
<style>
  .projects .card { position: relative; border: 1px solid var(--global-divider-color); overflow: hidden; }
  .projects .card .card-body { display: flex; flex-direction: column; }
  .projects .card .stretched-link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .projects .card .github-icon { position: relative; z-index: 2; display: flex; align-items: center; gap: 1rem; margin-top: auto; }
  .projects .card .card-link { font-size: 0.9rem; font-weight: 400; }
  /* Three cards per row: at the theme's h2 size most titles wrap to two lines. */
  .projects .card .card-title { font-size: 1.45rem; }
  /* Same image shape on every card, whatever the screenshot's size. */
  .projects .card .card-img-top { aspect-ratio: 16 / 10; object-fit: cover; border-bottom: 1px solid var(--global-divider-color); border-radius: 0; }
  .projects { margin-bottom: 1.5rem; }
  /* Flat cards: thin border, no shadow. Hover only turns the border to the accent
     color: no lift, shadow or zoom (this also cancels the theme's .hoverable lift). */
  .projects .card { box-shadow: none; transition: border-color 0.2s ease; }
  .projects .card.hoverable:hover,
  .projects .card:hover,
  .projects .card:focus-within {
    transform: none;
    box-shadow: none;
    border-color: var(--global-theme-color);
  }
  .projects .card figure { margin: 0; }
  /* Tech stack (front matter `stack`), monospace and muted, above the links.
     Each item starts with a separator; the list is shifted left by one separator
     width and that strip is clipped, so no line starts or ends with a dot. */
  .projects .card .card-stack {
    display: flex;
    flex-wrap: wrap;
    margin: auto 0 0.75rem -1.4em;
    padding: 0;
    list-style: none;
    clip-path: inset(0 0 0 1.4em);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--global-text-color-light);
  }
  .projects .card .card-stack li {
    margin: 0;
    color: inherit;
    white-space: nowrap;
  }
  .projects .card .card-stack li::before {
    content: "·";
    content: "·" / "";
    display: inline-block;
    width: 1.4em;
    text-align: center;
  }
  .projects .card .card-stack + .github-icon { margin-top: 0; }
  @media (prefers-reduced-motion: reduce) {
    .projects .card { transition: none; }
  }
</style>
