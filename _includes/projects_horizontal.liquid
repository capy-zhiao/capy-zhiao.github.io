{%- comment -%}
  Local override of al_folio_core's projects_horizontal.liquid, built the same way as
  projects.liquid here: the title is the card link (stretched over the card) and the
  code link, if any, sits above it with its own label. No nested anchors.
{%- endcomment -%}
{% capture project_href %}{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}{% endcapture %}
<div class="col mb-4">
  <div class="card h-100 hoverable card-horizontal">
    <div class="card-horizontal-row">
      {% if project.img %}
        <div class="card-horizontal-img">
          {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 320px, 100vw" alt="" class="card-img" %}
        </div>
      {% endif %}
      <div class="card-horizontal-body">
        <div class="card-body">
          <h3 class="card-title">
            <a href="{{ project_href }}" class="stretched-link" style="color: inherit">{{ project.title }}</a>
          </h3>
          <p class="card-text">{{ project.description }}</p>
          {% if project.github %}
            <div class="github-icon">
              <a
                href="{{ project.github }}"
                aria-label="View {{ project.title }} source on GitHub"
                title="View {{ project.title }} source on GitHub"
              >
                <i class="fa-brands fa-github gh-icon" aria-hidden="true"></i>
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
