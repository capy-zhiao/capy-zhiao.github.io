{%- comment -%}
  Skills as rows, one row per category. The rows group the skills, so the
  category name is not shown; it stays as the list's accessible name. Each
  skill is a small code tag: monospace, lowercase, thin border.
  Usage: {% include skills.liquid rows=site.data.skills %}
{%- endcomment -%}
<style>
  .skills {
    margin-bottom: 2rem;
    border-top: 1px solid var(--global-divider-color);
  }
  .skills-row {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }
  .skills .skills-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .skills .skills-items li {
    margin: 0;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    text-transform: lowercase;
  }
</style>
<div class="skills">
  {% for row in include.rows %}
    <div class="skills-row">
      <ul class="skills-items" role="list" aria-label="{{ row.category | escape }}">
        {% for item in row.items %}
          <li>{{ item | escape }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}
</div>
