{%- comment -%}
  Skills as rows, one row per category. The rows group the skills, so the
  category name is not shown; it stays as the list's accessible name.
  Usage: {% include skills.liquid rows=site.data.skills %}
{%- endcomment -%}
<style>
  .skills {
    margin-bottom: 2rem;
    border-top: 1px solid var(--global-divider-color);
  }
  .skills-row {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }
  /* Each item starts with a separator. The list is shifted left by one
     separator width and that strip is clipped, so the separator in front of
     the first item on every line (including wrapped lines) is hidden. */
  .skills .skills-items {
    display: flex;
    flex-wrap: wrap;
    margin: 0 0 0 -1.2rem;
    padding: 0;
    list-style: none;
    clip-path: inset(0 0 0 1.2rem);
  }
  .skills .skills-items li {
    margin: 0;
  }
  .skills .skills-items li::before {
    content: '·';
    content: '·' / '';
    display: inline-block;
    width: 1.2rem;
    text-align: center;
    font-weight: 700;
    color: var(--global-text-color-light);
  }
</style>
<div class="skills">
  {% for row in include.rows %}
    <div class="skills-row">
      <ul class="skills-items" role="list" aria-label="{{ row.category | escape }}">
        {% for item in row.items %}
          <li>{{ item | escape }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}
</div>
