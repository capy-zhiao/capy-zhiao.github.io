{%- comment -%}
  Styles for timeline.liquid (experience / education entries). Include once
  per page. Without a logo file, an entry shows its `short` name in a badge.
{%- endcomment -%}
<style>
  .timeline {
    margin-bottom: 2rem;
  }
  .timeline-entry {
    display: flex;
    gap: 1.25rem;
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin-bottom: 1.75rem;
    border-left: 4px solid var(--global-divider-color);
  }
  .timeline-logo {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
  }
  .timeline-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .timeline-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    border: 2px solid var(--global-theme-color);
    color: var(--global-theme-color);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .timeline-body {
    flex: 1 1 0;
    min-width: 0;
  }
  .timeline-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 1rem;
  }
  .timeline-org {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .timeline-org a {
    color: inherit;
  }
  .timeline-org a:hover {
    color: var(--global-theme-color);
  }
  .timeline-location,
  .timeline-date {
    color: var(--global-text-color-light);
    white-space: nowrap;
  }
  .timeline-role-row {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px dotted var(--global-divider-color);
  }
  .timeline-role {
    font-style: italic;
  }
  .timeline-tags {
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .timeline-tag {
    font-size: 0.8rem;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    background: var(--global-code-bg-color);
    color: var(--global-text-color-light);
  }
  .timeline-summary {
    margin-top: 0.6rem;
    color: var(--global-text-color-light);
  }
  .timeline-summary p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 575.98px) {
    .timeline-entry {
      gap: 0.9rem;
      padding-left: 0.9rem;
    }
    .timeline-logo {
      flex-basis: 44px;
      width: 44px;
      height: 44px;
    }
    .timeline-badge {
      font-size: 0.7rem;
      border-radius: 6px;
    }
  }
</style>
