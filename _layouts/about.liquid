---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    <style>
      /* Phones: the theme makes the profile photo full width, which pushes the
         projects a whole screen down. Keep it smaller and centered there. */
      @media (max-width: 575.98px) {
        .profile { width: 55%; float: none !important; margin: 0 auto 1rem auto !important; }
      }
      /* The Email / LinkedIn / GitHub buttons near the top cover contact, so the
         icon row at the bottom is a quiet repeat instead of 4rem icons. */
      .social .contact-icons { font-size: 2rem; }
      article > .clearfix p { max-width: 46rem; }
      .publications { margin-bottom: 1rem; }
      @media (max-width: 575.98px) {
        .publications abbr.badge { width: auto !important; padding: 0.25rem 0.6rem; }
      }
    </style>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Proof lines and contact buttons (page.highlights, _data/socials.yml) -->
    {% include hero.liquid %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Experience and education (entries in _data/experience.yml and _data/education.yml) -->
    {% if page.experience or page.education %}
      {% include timeline_styles.liquid %}
    {% endif %}

    {% if page.experience and site.data.experience %}
      <h2>experience</h2>
      {% include timeline.liquid entries=site.data.experience %}
    {% endif %}

    {% if page.education and site.data.education %}
      <h2>education</h2>
      {% include timeline.liquid entries=site.data.education %}
    {% endif %}

    <!-- Selected projects: one grid, three cards per row, in each project's home_order -->
    {% if page.selected_projects %}
      <h2>
        <a href="{{ '/projects/' | relative_url }}" style="color: inherit">selected projects</a>
      </h2>
      {% assign home_projects = site.projects | sort: 'home_order' %}
      {% include project_card_styles.liquid %}
      <div class="projects">
        <div class="row row-cols-1 row-cols-md-3">
          {% for project in home_projects %}
            {% include projects.liquid %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">research</a>
      </h2>
      <p><small>* denotes equal contribution.</small></p>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Skills (rows in _data/skills.yml) -->
    {% if page.skills and site.data.skills %}
      <h2>skills</h2>
      {% include skills.liquid rows=site.data.skills %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    <!-- Personal note -->
    <div class="personal-note" style="text-align: center; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--global-divider-color); color: var(--global-text-color-light); font-size: 1.05rem;">
      Forever loving my hamster 🐹
    </div>

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
